{# Sitewide accessible booking modal (docs/07-booking-engine.md). Every "Book a
   15-Minute Call" trigger opens this same dialog. Dates/times shown are DEMO data —
   see docs/12-booking-integration-contract.md for the real n8n contract this stands in for. #}
<dialog id="booking-modal" class="dialog booking-modal" aria-labelledby="booking-modal-title">
  <div class="dialog__panel booking-modal__panel">
    <div class="dialog__header">
      <h2 id="booking-modal-title">Book a 15-Minute Call</h2>
      <button type="button" class="dialog__close" data-dialog-close aria-label="Close booking dialog">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <p class="booking-modal__demo-notice">
      Demo booking flow — the dates and times below are placeholder data, not real availability.
      Live scheduling connects to Google Calendar through a secure backend once the booking
      settings in docs/10-decisions-and-todos.md are confirmed.
    </p>

    <ol class="booking-modal__steps" aria-label="Booking steps">
      <li data-step-indicator="date">1. Date</li>
      <li data-step-indicator="slot">2. Time</li>
      <li data-step-indicator="details">3. Details</li>
      <li data-step-indicator="confirmation">4. Confirmation</li>
    </ol>

    <div class="booking-modal__body" data-booking-root>
      <section data-booking-step="date">
        <h3>Choose a date</h3>
        <p class="booking-modal__timezone">
          Your timezone: <span data-booking-timezone>—</span>
          <label class="booking-modal__timezone-override">
            Not correct?
            <select data-booking-timezone-select>
              <option value="">Use detected timezone</option>
              <option value="America/New_York">Eastern Time (US)</option>
              <option value="America/Chicago">Central Time (US)</option>
              <option value="America/Denver">Mountain Time (US)</option>
              <option value="America/Los_Angeles">Pacific Time (US)</option>
              <option value="America/Toronto">Eastern Time (Canada)</option>
              <option value="Australia/Sydney">Sydney</option>
              <option value="Pacific/Auckland">Auckland</option>
              <option value="Europe/Berlin">Berlin</option>
              <option value="Europe/London">London</option>
            </select>
          </label>
        </p>
        <div class="booking-modal__options" data-booking-dates role="listbox" aria-label="Available dates"></div>
      </section>

      <section data-booking-step="slot" hidden>
        <h3>Choose a time</h3>
        <p data-booking-selected-date></p>
        <div class="booking-modal__options" data-booking-slots role="listbox" aria-label="Available times"></div>
        <button type="button" class="button button--secondary" data-booking-back="date">Back</button>
      </section>

      <section data-booking-step="details" hidden>
        <h3>Your details</h3>
        <form data-booking-form novalidate>
          <div class="field">
            <label class="field__label" for="booking-name">Full name *</label>
            <input class="field__control" id="booking-name" name="fullName" type="text" required autocomplete="name">
            <p class="field__error" data-booking-error-for="fullName" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="booking-email">Email address *</label>
            <input class="field__control" id="booking-email" name="email" type="email" required autocomplete="email">
            <p class="field__error" data-booking-error-for="email" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="booking-phone">Mobile number (with country code) *</label>
            <input class="field__control" id="booking-phone" name="phone" type="tel" required autocomplete="tel">
            <p class="field__error" data-booking-error-for="phone" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="booking-business">Business name *</label>
            <input class="field__control" id="booking-business" name="businessName" type="text" required autocomplete="organization">
            <p class="field__error" data-booking-error-for="businessName" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="booking-website">Existing website (optional)</label>
            <input class="field__control" id="booking-website" name="website" type="text">
          </div>
          <div class="field">
            <label class="field__label" for="booking-country">Country (optional)</label>
            <input class="field__control" id="booking-country" name="country" type="text">
          </div>
          <div class="field">
            <label class="field__label" for="booking-message">Message (optional)</label>
            <textarea class="field__control" id="booking-message" name="message" rows="3"></textarea>
          </div>
          <p class="field__hint">By booking, you agree to our <a href="/privacy-policy/">Privacy Policy</a>.</p>
          <div class="booking-modal__form-actions">
            <button type="button" class="button button--secondary" data-booking-back="slot">Back</button>
            <button type="submit" class="button button--primary" data-booking-submit>Confirm booking</button>
          </div>
          <p class="booking-modal__submit-error field__error" data-booking-submit-error role="alert" hidden></p>
        </form>
      </section>

      <section data-booking-step="confirmation" hidden>
        <h3>You're booked</h3>
        <p data-booking-confirmation-summary></p>
        <p class="field__hint">
          A calendar invite with a Google Meet link will be sent once this connects to the live booking backend.
        </p>
        <button type="button" class="button button--primary" data-dialog-close>Close</button>
      </section>
    </div>
  </div>
</dialog>
