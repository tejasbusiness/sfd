{# Sitewide accessible booking modal (docs/07-booking-engine.md). Every "Book a
   30-Minute Discovery Call" trigger opens this same dialog. Times come from the PHP API
   (GET /api/availability, docs/14-database-and-api.md). #}
{% from "partials/country-code-options.njk" import options as countryCodeOptions %}
{% import "partials/form-fields.njk" as fields %}
<dialog id="booking-modal" class="dialog booking-modal" aria-labelledby="booking-modal-title">
  <div class="dialog__panel booking-modal__panel">
    <div class="dialog__header booking-modal__header">
      <div class="booking-modal__heading-group">
        <h2 id="booking-modal-title" class="booking-modal__title">Book a Free 30-Minute Discovery Call</h2>
      </div>
      <button type="button" class="dialog__close" data-dialog-close aria-label="Close booking dialog">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <ol class="booking-modal__steps" aria-label="Booking steps">
      <li data-step-indicator="date"><span class="booking-modal__step-num">1</span><span class="booking-modal__step-label">Date</span></li>
      <li data-step-indicator="slot"><span class="booking-modal__step-num">2</span><span class="booking-modal__step-label">Time</span></li>
      <li data-step-indicator="details"><span class="booking-modal__step-num">3</span><span class="booking-modal__step-label">Details</span></li>
      <li data-step-indicator="confirmation"><span class="booking-modal__step-num">4</span><span class="booking-modal__step-label">Confirmation</span></li>
    </ol>

    <div class="booking-modal__body" data-booking-root>
      <section data-booking-step="date">
        <div class="booking-modal__step-head">
          <h3>Choose a date</h3>
          <p class="booking-modal__timezone">
            <span>Timezone: <strong data-booking-timezone>—</strong></span>
            <label class="booking-modal__timezone-override">
              Not correct?
              <select class="booking-modal__timezone-select" data-booking-timezone-select data-enhance="select">
                <option value="">Use detected timezone</option>
                <option value="America/New_York">Eastern Time (US)</option>
                <option value="America/Chicago">Central Time (US)</option>
                <option value="America/Denver">Mountain Time (US)</option>
                <option value="America/Los_Angeles">Pacific Time (US)</option>
                <option value="America/Toronto">Eastern Time (Canada)</option>
                <option value="Australia/Sydney">Sydney</option>
                <option value="Pacific/Auckland">Auckland</option>
                <option value="Europe/Berlin">Berlin</option>
                <option value="Europe/London">London</option>
              </select>
            </label>
          </p>
        </div>
        <div class="booking-modal__options booking-modal__options--dates" data-booking-dates role="listbox" aria-label="Available dates"></div>
      </section>

      <section data-booking-step="slot" hidden>
        <div class="booking-modal__step-head">
          <h3>Choose a time</h3>
          <p class="booking-modal__selected-date" data-booking-selected-date></p>
        </div>
        <div class="booking-modal__options booking-modal__options--slots" data-booking-slots role="listbox" aria-label="Available times"></div>
        <div class="booking-modal__step-actions">
          <button type="button" class="button button--secondary" data-booking-back="date">Back</button>
        </div>
      </section>

      <section data-booking-step="details" hidden>
        <h3>Your details</h3>
        <form class="sfd-form" data-booking-form novalidate>
          {{ fields.honeypot() }}
          {{ fields.input("booking-name", "fullName", "Full name *", required=true, autocomplete="name") }}
          {{ fields.input("booking-email", "email", "Email address *", type="email", required=true, autocomplete="email") }}
          {{ fields.phone("booking", countryCodes, countryCodeOptions) }}
          {{ fields.input("booking-country", "country", "Country (optional)") }}
          {{ fields.input("booking-business", "businessName", "Business name *", required=true, autocomplete="organization") }}
          {{ fields.input("booking-website", "website", "Existing website (optional)", inputmode="url", autocomplete="url", website=true) }}
          {{ fields.textarea("booking-message", "message", "Message *", required=true) }}
          {{ fields.consent("booking-consent", "consent", 'I confirm the information I have provided is accurate and I agree to SynergyFirst Digital using it to arrange this call. See our <a href="/privacy-policy/">Privacy Policy</a>. *') }}
          <div class="sfd-form__actions field--full">
            <button type="button" class="button button--secondary" data-booking-back="slot">Back</button>
            <button type="submit" class="button button--primary" data-booking-submit>Confirm booking</button>
          </div>
        </form>
      </section>

      <section data-booking-step="confirmation" hidden>
        <div class="booking-modal__confirmation">
          <span class="booking-modal__confirmation-icon" aria-hidden="true">&check;</span>
          <h3>Your appointment is booked</h3>
          <p data-booking-confirmation-summary></p>
          <p class="field__hint">
            Check your email for the confirmation. If your Google Meet link is not in it yet, we will send it before the call.
          </p>
          <button type="button" class="button button--primary" data-dialog-close>Close</button>
        </div>
      </section>
    </div>
  </div>
</dialog>
