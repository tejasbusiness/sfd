{# Sitewide accessible booking modal (docs/07-booking-engine.md). Every "Book a
   15-Minute Call" trigger opens this same dialog. Dates/times shown are DEMO data —
   see docs/12-booking-integration-contract.md for the real n8n contract this stands in for. #}
{% from "partials/country-code-options.njk" import options as countryCodeOptions %}
<dialog id="booking-modal" class="dialog booking-modal" aria-labelledby="booking-modal-title">
  <div class="dialog__panel booking-modal__panel">
    <div class="dialog__header booking-modal__header">
      <div class="booking-modal__heading-group">
        <h2 id="booking-modal-title" class="booking-modal__title">Book a Free 30-Minute Discovery Call</h2>
        <p class="booking-modal__demo-notice">
          <span class="booking-modal__demo-badge">Demo</span>
          <span class="booking-modal__demo-text">Dates and times below are placeholder data. Live scheduling connects once the booking
          settings in docs/10-decisions-and-todos.md are confirmed.</span>
        </p>
      </div>
      <button type="button" class="dialog__close" data-dialog-close aria-label="Close booking dialog">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <ol class="booking-modal__steps" aria-label="Booking steps">
      <li data-step-indicator="date"><span class="booking-modal__step-num">1</span><span class="booking-modal__step-label">Date</span></li>
      <li data-step-indicator="slot"><span class="booking-modal__step-num">2</span><span class="booking-modal__step-label">Time</span></li>
      <li data-step-indicator="details"><span class="booking-modal__step-num">3</span><span class="booking-modal__step-label">Details</span></li>
      <li data-step-indicator="confirmation"><span class="booking-modal__step-num">4</span><span class="booking-modal__step-label">Confirmation</span></li>
    </ol>

    <div class="booking-modal__body" data-booking-root>
      <section data-booking-step="date">
        <div class="booking-modal__step-head">
          <h3>Choose a date</h3>
          <p class="booking-modal__timezone">
            <span>Timezone: <strong data-booking-timezone>—</strong></span>
            <label class="booking-modal__timezone-override">
              Not correct?
              <select class="booking-modal__timezone-select" data-booking-timezone-select data-enhance="select">
                <option value="">Use detected timezone</option>
                <option value="America/New_York">Eastern Time (US)</option>
                <option value="America/Chicago">Central Time (US)</option>
                <option value="America/Denver">Mountain Time (US)</option>
                <option value="America/Los_Angeles">Pacific Time (US)</option>
                <option value="America/Toronto">Eastern Time (Canada)</option>
                <option value="Australia/Sydney">Sydney</option>
                <option value="Pacific/Auckland">Auckland</option>
                <option value="Europe/Berlin">Berlin</option>
                <option value="Europe/London">London</option>
              </select>
            </label>
          </p>
        </div>
        <div class="booking-modal__options booking-modal__options--dates" data-booking-dates role="listbox" aria-label="Available dates"></div>
      </section>

      <section data-booking-step="slot" hidden>
        <div class="booking-modal__step-head">
          <h3>Choose a time</h3>
          <p class="booking-modal__selected-date" data-booking-selected-date></p>
        </div>
        <div class="booking-modal__options booking-modal__options--slots" data-booking-slots role="listbox" aria-label="Available times"></div>
        <div class="booking-modal__step-actions">
          <button type="button" class="button button--secondary" data-booking-back="date">Back</button>
        </div>
      </section>

      <section data-booking-step="details" hidden>
        <h3>Your details</h3>
        <form class="booking-modal__form" data-booking-form novalidate>
          <div class="field field--floating">
            <label class="field__label" for="booking-name">Full name *</label>
            <input class="field__control" id="booking-name" name="fullName" type="text" placeholder=" " required autocomplete="name">
            <p class="field__error" data-booking-error-for="fullName" role="alert" hidden></p>
          </div>
          <div class="field field--floating">
            <label class="field__label" for="booking-email">Email address *</label>
            <input class="field__control" id="booking-email" name="email" type="email" placeholder=" " required autocomplete="email">
            <p class="field__error" data-booking-error-for="email" role="alert" hidden></p>
          </div>
          <div class="field phone-field">
            <div class="phone-field__row">
              <select class="field__control phone-field__code" id="booking-country-code" name="countryCode" data-enhance="country-select" data-default-iso2="{{ countryCodes.defaultIso2 }}">
                {{ countryCodeOptions(countryCodes) }}
              </select>
              <div class="phone-field__number-wrap">
                <label class="field__label" for="booking-phone">Mobile number *</label>
                <input class="field__control phone-field__number" id="booking-phone" name="mobileNumber" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder=" " required autocomplete="tel-national">
              </div>
            </div>
            <p class="field__error" data-booking-error-for="mobileNumber" role="alert" hidden></p>
            <p class="field__error" data-booking-error-for="countryCode" role="alert" hidden></p>
          </div>
          <div class="field field--floating">
            <label class="field__label" for="booking-country">Country (optional)</label>
            <input class="field__control" id="booking-country" name="country" type="text" placeholder=" ">
          </div>
          <div class="field field--floating">
            <label class="field__label" for="booking-business">Business name *</label>
            <input class="field__control" id="booking-business" name="businessName" type="text" placeholder=" " required autocomplete="organization">
            <p class="field__error" data-booking-error-for="businessName" role="alert" hidden></p>
          </div>
          <div class="field field--floating">
            <label class="field__label" for="booking-website">Existing website (optional)</label>
            <input class="field__control" id="booking-website" name="website" type="text" placeholder=" ">
          </div>
          <div class="field field--floating field--full">
            <label class="field__label" for="booking-message">Message *</label>
            <textarea class="field__control" id="booking-message" name="message" rows="2" placeholder=" " required></textarea>
            <p class="field__error" data-booking-error-for="message" role="alert" hidden></p>
          </div>
          <p class="field__hint field--full">By booking, you agree to our <a href="/privacy-policy/">Privacy Policy</a>.</p>
          <div class="booking-modal__form-actions field--full">
            <button type="button" class="button button--secondary" data-booking-back="slot">Back</button>
            <button type="submit" class="button button--primary" data-booking-submit>Confirm booking</button>
          </div>
          <p class="booking-modal__submit-error field__error field--full" data-booking-submit-error role="alert" hidden></p>
        </form>
      </section>

      <section data-booking-step="confirmation" hidden>
        <div class="booking-modal__confirmation">
          <span class="booking-modal__confirmation-icon" aria-hidden="true">&check;</span>
          <h3>Your appointment is booked</h3>
          <p data-booking-confirmation-summary></p>
          <p class="field__hint">
            A calendar invite with a Google Meet link will be sent once this connects to the live booking backend.
          </p>
          <button type="button" class="button button--primary" data-dialog-close>Close</button>
        </div>
      </section>
    </div>
  </div>
</dialog>
