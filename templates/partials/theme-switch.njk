{# Light / Dark / System colour theme switch. assets/js/theme.js binds the buttons
   (aria-pressed shows the active choice) and stores it in localStorage. #}
<div class="theme-switch" role="group" aria-label="Colour theme" data-theme-switch>
  <button type="button" class="theme-switch__btn" data-theme-choice="light" aria-pressed="false" aria-label="Light theme" title="Light">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"/></svg>
  </button>
  <button type="button" class="theme-switch__btn" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button type="button" class="theme-switch__btn" data-theme-choice="system" aria-pressed="false" aria-label="Match my device" title="System">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4" stroke-linecap="round"/></svg>
  </button>
</div>
