{# Bottom dock (desktop only): four primary destinations in a fixed black pill,
   from navigation.dock. Phones keep the tab bar in header.njk instead. #}
{% if navigation.dock and navigation.dock.length %}
<nav class="dock" aria-label="Quick links">
  {% for item in navigation.dock %}
  <a class="dock__link" href="{{ item.path }}"{% if page.canonicalPath == item.path %} aria-current="page"{% endif %}>
    <span aria-hidden="true">{{ item.icon | safe }}</span>{{ item.label }}
  </a>
  {% endfor %}
</nav>
{% endif %}
