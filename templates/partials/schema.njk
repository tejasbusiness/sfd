{# Structured data driven by each page's `schemaTypes` field (already a
   required field per docs/05, previously unused). Only verified data is
   emitted — no legal name, address, phone or social profile URLs, all of
   which remain BLOCKING/TBD per docs/10 and CLAUDE.md rule 13. #}
{% set canonicalUrl = site.productionDomain + page.canonicalPath %}

{% if "Organization" in page.schemaTypes %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","@id":{{ (site.productionDomain + "/#organization") | dump | safe }},"name":{{ company.tradingName | dump | safe }},"url":{{ site.productionDomain | dump | safe }},"logo":{{ (site.productionDomain + "/assets/images/brand/sfd-profile-purple-1080.png") | dump | safe }},"email":{{ company.supportEmail | dump | safe }}{% if company.description %},"description":{{ company.description | dump | safe }}{% endif %}}
</script>
{% endif %}

{% if "WebSite" in page.schemaTypes %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","@id":{{ (site.productionDomain + "/#website") | dump | safe }},"name":{{ company.tradingName | dump | safe }},"url":{{ site.productionDomain | dump | safe }},"publisher":{"@id":{{ (site.productionDomain + "/#organization") | dump | safe }}}}
</script>
{% endif %}

{# Service: what the page sells, from page.service ({ name, serviceType, description,
   audience }). No prices, ratings or service areas — only what the page states. #}
{% if "Service" in page.schemaTypes and page.service %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Service","@id":{{ (canonicalUrl + "#service") | dump | safe }},"name":{{ page.service.name | dump | safe }},"serviceType":{{ page.service.serviceType | dump | safe }},"description":{{ page.service.description | dump | safe }},"url":{{ canonicalUrl | dump | safe }},"provider":{"@type":"Organization","@id":{{ (site.productionDomain + "/#organization") | dump | safe }},"name":{{ company.tradingName | dump | safe }},"url":{{ site.productionDomain | dump | safe }}},"audience":{"@type":"BusinessAudience","audienceType":{{ page.service.audience | dump | safe }}}{% if page.service.startingPrice %},"offers":{"@type":"Offer","url":{{ (site.productionDomain + "/pricing/") | dump | safe }},"priceCurrency":"USD","priceSpecification":{"@type":"UnitPriceSpecification","price":{{ page.service.startingPrice | dump | safe }},"priceCurrency":"USD","unitText":"MONTH","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitCode":"MON"}},"description":"Monthly managed website plan, starting price. No activation fee."}{% endif %}}
</script>
{% endif %}

{% if "AboutPage" in page.schemaTypes or "ContactPage" in page.schemaTypes or "WebPage" in page.schemaTypes %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":{{ ("AboutPage" if "AboutPage" in page.schemaTypes else ("ContactPage" if "ContactPage" in page.schemaTypes else "WebPage")) | dump | safe }},"@id":{{ (canonicalUrl + "#webpage") | dump | safe }},"name":{{ page.seo.title | dump | safe }},"description":{{ page.seo.metaDescription | dump | safe }},"url":{{ canonicalUrl | dump | safe }},"inLanguage":{{ site.defaultLocale | dump | safe }},"isPartOf":{"@type":"WebSite","@id":{{ (site.productionDomain + "/#website") | dump | safe }},"name":{{ company.tradingName | dump | safe }},"url":{{ site.productionDomain | dump | safe }}},"publisher":{"@id":{{ (site.productionDomain + "/#organization") | dump | safe }}}{% if page.lastUpdated %},"dateModified":{{ page.lastUpdated | dump | safe }}{% endif %}{% if "Service" in page.schemaTypes and page.service %},"about":{"@id":{{ (canonicalUrl + "#service") | dump | safe }}}{% endif %}{% if "BreadcrumbList" in page.schemaTypes and page.breadcrumbs %},"breadcrumb":{"@id":{{ (canonicalUrl + "#breadcrumb") | dump | safe }}}{% endif %}}
</script>
{% endif %}

{% if "FAQPage" in page.schemaTypes %}
  {% set faqSection = null %}
  {% for s in page.sections %}
    {% if not faqSection and (s.type == "faq" or s.type == "faq-split") %}
      {% set faqSection = s %}
    {% endif %}
  {% endfor %}
  {% if faqSection %}
    {% set resolvedFaqItems = faqs.items | selectByIds(faqSection.itemIds) %}
    {% if resolvedFaqItems and resolvedFaqItems.length %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in resolvedFaqItems %}{"@type":"Question","name":{{ item.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.answer | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
    {% endif %}
  {% endif %}
{% endif %}

{# BreadcrumbList from page.breadcrumbs ([{label, path}], last item path null = current page). #}
{% if "BreadcrumbList" in page.schemaTypes and page.breadcrumbs %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","@id":{{ (canonicalUrl + "#breadcrumb") | dump | safe }},"itemListElement":[{% for crumb in page.breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ crumb.label | dump | safe }},"item":{{ ((site.productionDomain + crumb.path) if crumb.path else canonicalUrl) | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
