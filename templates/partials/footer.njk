<footer class="site-footer">
  {% if footer.statement %}
  <div class="footer-statement" aria-hidden="true">
    <div class="footer-statement__inner">
      <p class="footer-statement__text" data-weight-field>{{ footer.statement }}</p>
      {% for st in footer.statementStickers %}
      <span class="sticker sticker--f{{ loop.index }} sticker--{{ st.tone }}">{{ st.label }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        {% if footer.startLabel %}<p class="site-footer__brand-label">{{ footer.startLabel }}</p>{% endif %}
        {% if company.email %}<a class="site-footer__email" href="mailto:{{ company.email }}">{{ company.email }}</a>{% endif %}
        <img class="site-footer__wordmark" src="/assets/images/SFD-White-logo-footer.png" alt="{{ company.tradingName }}" width="836" height="150" loading="lazy" decoding="async">
        {% if footer.brandStatement %}<p class="site-footer__statement">{{ footer.brandStatement }}</p>{% endif %}
        {% if footer.startCta %}<a class="button button--primary" href="{{ footer.startCta.href }}"{% if footer.startCta.dialogTarget %} data-dialog-target="{{ footer.startCta.dialogTarget }}"{% endif %}>{{ footer.startCta.label }}</a>{% endif %}
      </div>

      {% if footer.groups and footer.groups.length %}
      <div class="site-footer__groups">
        {% for group in footer.groups %}
        <div class="site-footer__group">
          <h2 class="site-footer__group-title">{{ group.title }}</h2>
          <ul class="site-footer__group-list">
            {% for link in group.links %}
            {# link.path === null renders a plain label, never a broken link (docs/13 §8.13). #}
            <li>
              {% if link.path %}
              <a href="{{ link.path }}">{{ link.label }}</a>
              {% else %}
              <span class="site-footer__group-label">{{ link.label }}</span>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="site-footer__bottom">
      {% if footer.legalLinks and footer.legalLinks.length %}
      <nav class="site-footer__legal" aria-label="Legal">
        <ul>
          {% for link in footer.legalLinks %}
          <li><a href="{{ link.path }}">{{ link.label }}</a></li>
          {% endfor %}
          <li><button type="button" class="site-footer__link-button" data-cookie-settings>{{ footer.cookieConsent.settingsLinkLabel }}</button></li>
        </ul>
      </nav>
      {% endif %}
      <p class="site-footer__copyright">&copy; {{ buildYear }} {{ company.tradingName }}. All rights reserved.</p>
      {% if footer.social and footer.social.length %}
      <ul class="site-footer__social">
        {% for item in footer.social %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</footer>
