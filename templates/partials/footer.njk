<footer class="site-footer">
  {% if footer.statement %}
  <div class="footer-statement" aria-hidden="true">
    <div class="footer-statement__inner">
      <p class="footer-statement__text" data-weight-field>{{ footer.statement }}</p>
      {% for st in footer.statementStickers %}
      <span class="sticker sticker--f{{ loop.index }} sticker--{{ st.tone }}"><span class="sticker__fill">{{ st.label }}</span></span>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  <div class="site-footer__inner">
    {# Studio footer (2026-11-05): four columns with a clear hierarchy, after the owner's
       reference. Column 1 is the start-a-project block; columns 2 and 3 take the groups
       from footer.groups by their "column" number (style bold = display uppercase links,
       small = plain list); column 4 is "based in" with a live local time. #}
    <div class="site-footer__top site-footer__top--studio">
      <div class="site-footer__col site-footer__brand">
        {% if footer.startLabel %}<p class="site-footer__brand-label">{{ footer.startLabel }}</p>{% endif %}
        {% if footer.showEmail and company.supportEmail %}<a class="site-footer__email" href="mailto:{{ company.supportEmail }}">{{ company.supportEmail }}</a>{% endif %}
        {% if footer.brandStatement %}<p class="site-footer__statement">{{ footer.brandStatement }}</p>{% endif %}
        {% if footer.startCta %}<a class="button button--primary" href="{{ footer.startCta.href }}"{% if footer.startCta.dialogTarget %} data-dialog-target="{{ footer.startCta.dialogTarget }}"{% endif %}>{{ footer.startCta.label }} <span aria-hidden="true">&#8599;</span></a>{% endif %}
      </div>
      {% for col in [2, 3] %}
      <div class="site-footer__col">
        {% for group in footer.groups %}
        {% if group.column == col %}
        <div class="site-footer__group site-footer__group--{{ group.style }}">
          <h2 class="site-footer__group-title">{{ group.title }}</h2>
          <ul class="site-footer__group-list">
            {% for link in group.links %}
            <li>
              {% if link.path %}
              <a href="{{ link.path }}">{{ link.label }}</a>
              {% else %}
              <span class="site-footer__group-label">{{ link.label }}</span>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% endfor %}
      </div>
      {% endfor %}
      <div class="site-footer__col">
        {% if footer.basedIn %}
        <div class="site-footer__group site-footer__group--bold">
          <h2 class="site-footer__group-title">{{ footer.basedIn.label }}</h2>
          <p class="site-footer__place">{{ footer.basedIn.place }}</p>
          <p class="site-footer__time"><span class="site-footer__time-dot" aria-hidden="true"></span><span data-local-time="{{ footer.basedIn.timezone }}">--:--</span> {{ footer.basedIn.timeLabel }}</p>
        </div>
        {% endif %}
        {% if footer.askAi and footer.askAi.tools.length %}
        {# Each tile opens an AI assistant in a new tab with footer.askAi.prompt prefilled. #}
        <div class="site-footer__group site-footer__ai">
          <h2 class="site-footer__group-title">{{ footer.askAi.label }}</h2>
          <ul class="site-footer__ai-list">
            {% for tool in footer.askAi.tools %}
            <li><a class="site-footer__ai-tile" href="{{ tool.href }}{{ footer.askAi.prompt | urlencode }}" target="_blank" rel="noopener" aria-label="Ask {{ tool.name }} about {{ company.tradingName }} (opens in a new tab)" title="Ask {{ tool.name }}">{{ tool.icon | safe }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if footer.legalLinks and footer.legalLinks.length %}
        {# Legal links live in the last column (2026-11-05) so the bottom bar stays compact. #}
        <nav class="site-footer__group site-footer__group--small site-footer__legal site-footer__legal--column" aria-label="Legal">
          <h2 class="site-footer__group-title">Legal</h2>
          <ul class="site-footer__group-list">
            {% for link in footer.legalLinks %}
            <li><a href="{{ link.path }}">{{ link.label }}</a></li>
            {% endfor %}
            <li><button type="button" class="site-footer__link-button" data-cookie-settings>{{ footer.cookieConsent.settingsLinkLabel }}</button></li>
          </ul>
        </nav>
        {% endif %}
      </div>
    </div>

    {# Bottom bar (2026-11-05): logo left, copyright centred, Back to top right. #}
    <div class="site-footer__bottom site-footer__bottom--studio">
      <a class="site-footer__logo" href="/" aria-label="{{ company.tradingName }} home">
        {% include "partials/logo.njk" %}
      </a>
      <p class="site-footer__copyright">&copy; {{ buildYear }} {{ company.tradingName }}. All rights reserved.</p>
      <a class="site-footer__top-link" href="#main-content">Back to top <span aria-hidden="true">&uarr;</span></a>
    </div>
  </div>
</footer>
