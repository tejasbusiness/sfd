<!doctype html>
<html lang="{{ site.defaultLocale }}">
<head>
  <meta charset="utf-8">
  <script>(function(){try{var p=localStorage.getItem("sfd-theme");p=p==="light"||p==="dark"?p:"system";var d=p==="dark"||(p==="system"&&window.matchMedia("(prefers-color-scheme: dark)").matches);document.documentElement.setAttribute("data-theme",d?"dark":"light");document.documentElement.setAttribute("data-theme-pref",p)}catch(e){}})()</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.seo.title }}</title>
  <meta name="description" content="{{ page.seo.metaDescription }}">
  {% if page.type != "not-found" %}
  <link rel="canonical" href="{{ site.productionDomain }}{{ page.canonicalPath }}">
  {% endif %}
  <link rel="icon" type="image/jpeg" href="/assets/images/sfd-512-black.jpeg">
  <meta name="robots" content="{{ page.seo.robots }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.seo.ogTitle }}">
  <meta property="og:description" content="{{ page.seo.ogDescription }}">
  <meta property="og:image" content="{{ site.productionDomain }}{{ page.seo.ogImage }}">
  <meta property="og:image:alt" content="{{ company.tradingName }}">
  <meta property="og:site_name" content="{{ company.tradingName }}">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page.seo.ogTitle }}">
  <meta name="twitter:description" content="{{ page.seo.ogDescription }}">
  <meta name="twitter:image" content="{{ site.productionDomain }}{{ page.seo.ogImage }}">
  {% if page.type != "not-found" %}
  <meta property="og:url" content="{{ site.productionDomain }}{{ page.canonicalPath }}">
  {% endif %}
  {# Self-hosted variable fonts (2026-11-05): Inter and Archivo, Latin subsets preloaded so the
     headline does not swap late; see assets/css/fonts.css and assets/fonts/LICENSE-fonts.txt. #}
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/motion.css">
  <link rel="stylesheet" href="/assets/css/studio.css">
  <link rel="stylesheet" href="/assets/css/studio-layout.css">
  {% if page.id == "home" %}
  <link rel="stylesheet" href="/assets/css/homepage.css">
  {% endif %}
  {% if page.type != "not-found" and page.schemaTypes and page.schemaTypes.length %}
  {% include "partials/schema.njk" %}
  {% endif %}
</head>
<body{% if page.id == "home" %} class="page-home"{% endif %}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "partials/header.njk" %}
  <main id="main-content">
    {% block content %}{% endblock %}
  </main>
  {# Band above the footer: the homepage offers the Free Website Audit; other pages keep the playbook. #}
  {% if page.leadOffer == "website-review" %}{% include "partials/website-review.njk" %}
  {% elif not page.hidePlaybook %}{% include "partials/playbook.njk" %}{% endif %}
  {% include "partials/footer.njk" %}
  {% include "partials/dock.njk" %}
  {% include "partials/cookie-banner.njk" %}
  <script defer src="/assets/js/vendor/lenis.min.js"></script>
  <script type="module" src="/assets/js/main.js"></script>
</body>
</html>
