{# Homepage-only redesigned hero (docs/13 §8.1). The "hero" type/template used by
   How It Works and Pricing is untouched — this is a separate type on purpose. #}
{% if section.statement %}
{# Statement hero (2026-11-05): centred uppercase display headline with sticker pills.
   Every sticker is a verified fact from section.stickers (same source as the old stats). #}
<section class="section hero-split hero-statement">
  <div class="container hero-statement__inner" data-reveal>
    {% if section.status %}
    <p class="hero-status">
      <span class="hero-status__dot" aria-hidden="true"></span>{{ section.status.label }}
      {% if section.status.link %}<span class="hero-status__sep" aria-hidden="true"></span><a href="{{ section.status.link.href }}"{% if section.status.link.dialogTarget %} data-dialog-target="{{ section.status.link.dialogTarget }}"{% endif %}>{{ section.status.link.label }} &rarr;</a>{% endif %}
    </p>
    {% endif %}
    <h1 data-weight-field>{{ page.h1 | safe }}</h1>
    {% if section.stickers %}
    <div class="hero-stickers">
      {% for st in section.stickers %}
      <span class="sticker sticker--{{ loop.index }} sticker--{{ st.tone }}{% if st.shape %} sticker--{{ st.shape }}{% endif %}">{{ st.label }}</span>
      {% endfor %}
    </div>
    {% endif %}
    <p class="hero-statement__sub">{{ section.subheading }}</p>
    <div class="hero-statement__actions">
      <a class="button button--primary" href="{{ section.primaryCta.href }}">{{ section.primaryCta.label }}</a>
      {% if section.secondaryCta %}
      <a class="button button--secondary" href="{{ section.secondaryCta.href }}"{% if section.secondaryCta.dialogTarget %} data-dialog-target="{{ section.secondaryCta.dialogTarget }}"{% endif %}>{{ section.secondaryCta.label }}</a>
      {% endif %}
    </div>
    {% if section.priceContext %}
    <p class="hero-statement__price">{{ section.priceContext.prefix }} <strong>{{ plans.plans[0].priceMonthly }}/month</strong>. {{ plans.commitmentTerms }}</p>
    {% endif %}
  </div>
</section>
{% else %}
<section class="section hero-split">
  <div class="container grid-12 hero-split__grid">
    <div class="hero-split__content col-span-7" data-reveal>
      <p class="eyebrow">{{ section.eyebrow }}</p>
      <h1>{{ page.h1 | safe }}</h1>
      <p class="hero-split__subheading">{{ section.subheading }}</p>
      {% if section.qualificationNote %}<p class="hero-split__note">{{ section.qualificationNote }}</p>{% endif %}
      <div class="hero-split__actions">
        <a class="button button--primary" href="{{ section.primaryCta.href }}">{{ section.primaryCta.label }}</a>
        {% if section.secondaryCta %}
        <a
          class="button button--secondary"
          href="{{ section.secondaryCta.href }}"
          {% if section.secondaryCta.dialogTarget %}data-dialog-target="{{ section.secondaryCta.dialogTarget }}"{% endif %}
        >{{ section.secondaryCta.label }}</a>
        {% endif %}
      </div>
      {% if section.reassurance %}<p class="hero-split__reassurance">{{ section.reassurance }}</p>{% endif %}
      {% if section.priceContext %}
      {# Starting price comes from plans.json so it never drifts from the Pricing page. #}
      <p class="hero-split__price">{{ section.priceContext.prefix }} <strong>{{ plans.plans[0].priceMonthly }}/month</strong>. {{ plans.commitmentTerms }}</p>
      {% endif %}
      {% if section.stats %}
      <div class="hero-split__stats">
        {% for stat in section.stats %}
        <div class="hero-split__stat">
          <span class="hero-split__stat-value">{{ stat.value }}</span>
          <span class="hero-split__stat-label">{{ stat.label }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="hero-split__visual col-span-5 col-start-8" data-reveal>
      {% if section.carousel %}
      {# Curved carousel of real client projects (2026-11-05). The 3D ring is decorative and
         hidden from assistive tech; the caption below holds the real, focusable links.
         Projects are repeated to fill eight slots so the arc never shows a gap. #}
      {% set heroProjects = projects.items | selectByIds(section.carousel.ids) %}
      {% set slots = 8 %}
      <figure class="hero-carousel">
        <div class="hero-carousel__stage" aria-hidden="true">
          <ul class="hero-carousel__ring" style="--n: {{ slots }}">
            {% for i in range(0, slots) %}
            {% set item = heroProjects[i % heroProjects.length] %}
            <li class="hero-carousel__item" style="--i: {{ i }}">
              <a href="{{ item.caseStudy.path }}" tabindex="-1">
                <img src="{{ item.images.desktop }}" alt="" width="1440" height="900" {% if i == 0 %}loading="eager" fetchpriority="high"{% elif i < heroProjects.length %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        <figcaption class="hero-project__caption">{{ section.carousel.captionPrefix }}
          {% for item in heroProjects %}<a href="{{ item.caseStudy.path }}">{{ item.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
        </figcaption>
      </figure>
      {% elif section.project %}
      {# Real client work above the fold: a screenshot from projects.json, linked to its case study. #}
      {% set heroProject = (projects.items | selectByIds([section.project.id]))[0] %}
      <figure class="hero-project">
        <a class="hero-project__link" href="{{ heroProject.caseStudy.path }}">
          <div class="browser-frame">
            <div class="browser-frame__bar">
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__dot"></span>
            </div>
            <img class="hero-project__image" src="{{ heroProject.images.desktop }}" alt="Homepage of the {{ heroProject.title }} website, designed and built by SynergyFirst Digital" width="1440" height="900" loading="eager" fetchpriority="high" decoding="async">
          </div>
        </a>
        <figcaption class="hero-project__caption">{{ section.project.captionPrefix }} <a href="{{ heroProject.caseStudy.path }}">{{ heroProject.title }}</a> &middot; {{ heroProject.industryLabel }}</figcaption>
      </figure>
      {% else %}
      {# One labelled image for assistive tech; the mock-up text inside is decorative. #}
      <div class="hero-visual" role="img" aria-label="{{ section.visual.label }}">
        <div class="hero-visual__before">
          <p class="hero-visual__tag hero-visual__tag--before">Before</p>
          <div class="browser-frame browser-frame--muted">
            <div class="browser-frame__bar">
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__dot"></span>
            </div>
            <div class="browser-frame__body browser-frame__body--before">
              <div class="mock-before__nav">HOME&nbsp;&nbsp;ABOUT&nbsp;&nbsp;SERVICES&nbsp;&nbsp;CONTACT</div>
              <p class="mock-before__heading">Welcome To Our Company</p>
              <div class="hero-visual__line"></div>
              <div class="hero-visual__line hero-visual__line--short"></div>
              <span class="mock-before__button">Contact Us</span>
            </div>
          </div>
        </div>

        <div class="hero-visual__arrow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <div class="hero-visual__after">
          <p class="hero-visual__tag hero-visual__tag--after">After</p>
          <div class="browser-frame">
            <div class="browser-frame__bar">
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__dot"></span>
              <span class="browser-frame__address">yourbusiness.com</span>
            </div>
            <div class="browser-frame__body">
              <div class="mock-site__nav">
                <span class="mock-site__logo">Your Business</span>
                <span class="mock-site__nav-links">Services&nbsp;&nbsp;Reviews&nbsp;&nbsp;Contact</span>
                <span class="mock-site__cta">Call Now</span>
              </div>
              <div class="mock-site__hero">
                <div class="mock-site__hero-text">
                  <p class="mock-site__hero-heading">{{ section.visual.afterHeading | safe }}</p>
                  <p class="mock-site__hero-sub">{{ section.visual.afterSub }}</p>
                  <span class="mock-site__hero-button">{{ section.visual.afterCta }}</span>
                </div>
                <div class="mock-site__hero-image">
                  <img src="/assets/images/hero-photo-640.jpg" alt="" width="640" height="777" loading="eager">
                </div>
              </div>
              <div class="mock-site__trust">
                <span>✓ Licensed &amp; Insured</span>
                <span>✓ Free Quotes</span>
                <span>✓ Same-Day Service</span>
              </div>
            </div>
          </div>

          <div class="phone-frame">
            <div class="phone-frame__notch"></div>
            <div class="phone-frame__body">
              <div class="mock-site__nav mock-site__nav--mobile">
                <span class="mock-site__logo mock-site__logo--sm">Your Business</span>
                <span class="phone-frame__menu-icon"></span>
              </div>
              <div class="mock-site__hero-image mock-site__hero-image--mobile">
                <img src="/assets/images/hero-photo-640.jpg" alt="" width="640" height="777" loading="eager">
              </div>
              <p class="mock-site__hero-heading mock-site__hero-heading--sm">{{ section.visual.afterHeading | replace("<br>", " ") | safe }}</p>
              <span class="mock-site__hero-button mock-site__hero-button--sm">{{ section.visual.afterCta }}</span>
            </div>
          </div>
        </div>

        <div class="hero-visual__chip">
          <svg class="hero-visual__chip-ring" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
            <circle cx="13" cy="13" r="10" fill="none" stroke="var(--color-border)" stroke-width="3" />
            <circle cx="13" cy="13" r="10" fill="none" stroke="var(--color-accent)" stroke-width="3"
              stroke-dasharray="62.8" stroke-dashoffset="35.9" stroke-linecap="round"
              transform="rotate(-90 13 13)" />
          </svg>
          <span class="hero-visual__chip-text">Day 3 of 7 — private preview</span>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
