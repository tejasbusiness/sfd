{# The one full-bleed dark section (docs/13 §8.6, §5). Comparison is qualitative
   only — no invented dollar figures. #}
<section class="section section--dark statement">
  <div class="container statement__inner">
    <h2 class="statement__heading" data-reveal>
      {{ section.headingPrefix }}<span class="statement__highlight">{{ section.headingHighlight }}</span>{{ section.headingSuffix }}
    </h2>
    {% if section.intro %}<p class="statement__intro" data-reveal>{{ section.intro }}</p>{% endif %}
    {# Column headings are h3s and label their lists, so the ✕ / ✓ icons are
       never the only signal of which side an item belongs to. #}
    <div class="statement__comparison" data-reveal>
      <div class="statement__column">
        <h3 class="statement__column-label" id="statement-traditional">{{ section.traditionalLabel }}</h3>
        <ul aria-labelledby="statement-traditional">
          {% for point in section.traditional %}
          <li><span class="statement__icon statement__icon--no" aria-hidden="true">✕</span>{{ point }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="statement__column statement__column--sfd">
        <h3 class="statement__column-label" id="statement-sfd">{{ section.sfdLabel }}</h3>
        <ul aria-labelledby="statement-sfd">
          {% for point in section.sfd %}
          <li><span class="statement__icon statement__icon--yes" aria-hidden="true">✓</span>{{ point }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <a class="button button--accent" href="{{ section.cta.href }}">{{ section.cta.label }}</a>
  </div>
</section>
