{# Connected-module diagram (docs/13 §8.9) — replaces the reused feature-grid
   that previously represented growth services on the homepage. #}
<section class="section section--tinted growth-modules">
  <div class="container">
    <h2>{{ section.heading }}</h2>
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
    <div class="growth-modules__diagram" data-reveal>
      <div class="growth-modules__core">{{ section.core }}</div>
      <div class="growth-modules__connectors" aria-hidden="true"></div>
      <div class="growth-modules__items">
        {% for item in section.items %}
        <div class="card growth-modules__item">
          <span class="growth-modules__icon" aria-hidden="true">
            {% if loop.index == 1 %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
            {% elif loop.index == 2 %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h7l-1 8 11-14h-7l1-6z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% elif loop.index == 3 %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% else %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endif %}
          </span>
          <h4>{{ item.title }}</h4>
          <p>{{ item.body }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
