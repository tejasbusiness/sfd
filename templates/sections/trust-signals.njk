{# Replaces proof-strip.njk on the homepage (docs/13 §8.2). Four always-true,
   already-confirmed facts — no verified/TBD gating needed, nothing to omit. #}
<section class="section trust-signals">
  <div class="container trust-signals__inner">
    {% for item in section.items %}
    <p class="trust-signals__item" data-reveal>
      <svg class="trust-signals__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {{ item }}
    </p>
    {% endfor %}
  </div>
</section>
