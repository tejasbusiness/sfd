{# Homepage-only split FAQ layout (docs/13 §8.11). Keeps native <details>/<summary>
   semantics per the reviewer's amendment — styled only, no custom disclosure JS.
   faq.njk (single-column) stays untouched for How It Works and Pricing. #}
<section class="section faq-split">
  <div class="container faq-split__grid">
    <div class="faq-split__intro" data-reveal>
      <h2>{{ section.heading }}</h2>
      {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
      {% if section.cta %}
      <a class="button button--secondary" href="{{ section.cta.href }}">{{ section.cta.label }}</a>
      {% endif %}
    </div>
    <div class="faq-split__items" data-reveal>
      {% for item in faqs.items | selectByIds(section.itemIds) %}
      <details class="faq-split__item">
        <summary>
          {{ item.question }}
          <span class="faq-split__icon" aria-hidden="true"></span>
        </summary>
        <p>{{ item.answer }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
