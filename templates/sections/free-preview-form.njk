{# Free Website Preview request ("Show Me My New Website"), built on the shared form
   system (partials/form-fields.njk, .sfd-form) so it matches the booking modal.
   Kept low-friction (2026-10-02): name, email, business name and one website or
   Google Business Profile URL are required; phone, service and message are optional.
   Copy (button, consent, success toast) lives in the page JSON section. #}
{% from "partials/country-code-options.njk" import options as countryCodeOptions %}
{% import "partials/form-fields.njk" as fields %}
<section class="section free-preview-form">
  <div class="container" data-reveal>
    <h2>{{ section.heading }}</h2>
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}

    <form class="sfd-form sfd-form--page sfd-form--wide" data-free-preview-form data-loading-label="Sending…" data-success-title="{{ section.successTitle }}" data-success-message="{{ section.successMessage }}" novalidate>
      {{ fields.honeypot() }}
      {{ fields.input("fp-name", "fullName", "Your name *", required=true, autocomplete="name") }}
      {{ fields.input("fp-email", "email", "Email address *", type="email", required=true, autocomplete="email") }}
      {{ fields.phone("fp", countryCodes, countryCodeOptions, label="Phone (optional)", required=false) }}
      {{ fields.input("fp-business", "businessName", "Business name *", required=true, autocomplete="organization") }}
      {{ fields.input("fp-service", "primaryService", "Main service", maxlength="200") }}
      {{ fields.input("fp-website", "website", "Website or Google Business Profile URL *", required=true, inputmode="url", autocomplete="url", website=true, hint="No website yet? Paste your Google Business Profile link.") }}
      {{ fields.textarea("fp-problem", "problem", "Anything we should know? (optional)", rows=3) }}
      {{ fields.consent("fp-consent", "consent", section.consentLabel + " *") }}
      <div class="sfd-form__actions field--full">
        <button type="submit" class="button button--primary" data-free-preview-submit>{{ section.submitLabel }}</button>
      </div>
    </form>

  </div>
</section>
