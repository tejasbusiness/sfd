{# Free Preview application, built on the shared form system
   (partials/form-fields.njk, .sfd-form) so it matches the booking modal. #}
{% from "partials/country-code-options.njk" import options as countryCodeOptions %}
{% import "partials/form-fields.njk" as fields %}
{% set categories = [
  { value: "home-services", label: "Home services" },
  { value: "restaurants-hospitality", label: "Restaurants & hospitality" },
  { value: "healthcare", label: "Healthcare" },
  { value: "financial-services", label: "Financial services" },
  { value: "professional-services", label: "Professional services" },
  { value: "other", label: "Other" }
] %}
<section class="section free-preview-form">
  <div class="container" data-reveal>
    <h2>{{ section.heading }}</h2>
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}

    <form class="sfd-form sfd-form--page sfd-form--wide" data-free-preview-form data-loading-label="Submitting…" data-success-title="Application received" data-success-message="Thank you. We review every application to make sure we can create something genuinely useful for your business, and we'll be in touch if we can build you a free preview." novalidate>
      {{ fields.honeypot() }}
      {{ fields.input("fp-name", "fullName", "Full name *", required=true, autocomplete="name") }}
      {{ fields.input("fp-email", "email", "Email address *", type="email", required=true, autocomplete="email") }}
      {{ fields.phone("fp", countryCodes, countryCodeOptions) }}
      {{ fields.input("fp-business", "businessName", "Business name *", required=true, autocomplete="organization") }}
      {{ fields.input("fp-website", "website", "Existing website (optional)", inputmode="url", autocomplete="url", website=true) }}
      {{ fields.input("fp-gbp", "gbpUrl", "Google Business Profile URL (optional)", inputmode="url", website=true) }}
      {{ fields.input("fp-country", "country", "Country *", required=true, autocomplete="country-name") }}
      {{ fields.input("fp-city", "city", "City *", required=true, autocomplete="address-level2") }}
      {{ fields.select("fp-category", "category", "Business category *", categories, placeholder="Select a category", required=true) }}
      {{ fields.input("fp-service", "primaryService", "Primary service *", required=true, wide=true) }}
      {{ fields.textarea("fp-problem", "problem", "Main problem with your current website (or lack of one) *", required=true, rows=3) }}
      {{ fields.consent("fp-consent", "consent", "I confirm I have the right to share this information and any materials I provide, and I understand this application does not guarantee a preview. *") }}
      <div class="sfd-form__actions field--full">
        <button type="submit" class="button button--primary" data-free-preview-submit>Submit application</button>
      </div>
    </form>

  </div>
</section>
