{# Pricing page plans. With `section.services` the page shows one link per service;
   each is its own page (/pricing/, /pricing/seo/, ...) generated from
   data/pages/pricing.json `variants`, and `page.activeService` picks the panel
   rendered here. The Websites panel holds the plan cards from data/plans.json; the
   others show `section.placeholder` until their pricing is decided.
   assets/js/pricing-tabs.js keeps the scroll position when switching. #}
{% set websitePlans %}
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
    <div class="pricing-summary__plans">
      {% for plan in plans.plans %}
      <div class="card pricing-summary__plan {{ 'pricing-summary__plan--recommended' if plan.recommended else '' }} {{ 'pricing-summary__plan--compact' if plan.cta else '' }}" data-reveal>
        {% if plan.recommended %}<p class="pricing-summary__tag">★ Best Value</p>{% endif %}
        <h3>{{ plan.name }}</h3>
        {% if plan.tagline %}<p class="pricing-summary__tagline">{{ plan.tagline }}</p>{% endif %}
        {% if plan.idealFor %}<p class="pricing-summary__ideal {{ 'pricing-summary__ideal--bold' if not plan.cta else '' }}">{{ plan.idealFor }}</p>{% endif %}
        {% if plan.priceMonthly %}
        <p class="pricing-summary__price">{{ plan.priceMonthly }}/mo</p>
        {% endif %}
        <p>{{ plan.summary }}</p>
        {% if not plan.cta %}
        <ul class="pricing-summary__includes">
          {% for item in plan.includes %}
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {{ item }}
          </li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if plan.cta %}
        <a
          class="button button--secondary pricing-summary__plan-cta"
          href="{{ plan.cta.href }}"
          {% if plan.cta.dialogTarget %}data-dialog-target="{{ plan.cta.dialogTarget }}"{% endif %}
          aria-label="{{ plan.cta.label }}: talk to us about {{ plan.name }}"
        >{{ plan.cta.label }}</a>
        {% else %}
        <a
          class="button {{ 'button--accent' if plan.recommended else 'button--secondary' }} pricing-summary__plan-cta"
          href="/free-preview/"
          aria-label="Start with {{ plan.name }}: request your free website preview"
        >Start with {{ plan.name }}</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% if section.cta %}
    <a class="button button--primary" href="{{ section.cta.href }}">{{ section.cta.label }}</a>
    {% endif %}
    {% if section.note %}
    <p class="pricing-summary__note">
      <span class="pricing-summary__note-dot" aria-hidden="true"></span>
      <strong>{{ section.note.lead }}</strong> {{ section.note.body }}
    </p>
    {% endif %}
{% endset %}
<section class="section pricing-summary">
  <div class="container">
    {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
    {% if section.services %}
    <nav class="pricing-tabs" aria-label="Pricing by service" data-pricing-tabs>
      <ul class="pricing-tabs__list">
        {% for service in section.services %}
        <li><a class="pricing-tabs__tab{{ ' is-active' if service.id == page.activeService }}" href="{{ service.path }}"{% if service.id == page.activeService %} aria-current="page"{% endif %}>{{ service.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {% for service in section.services %}
    {% if service.id == page.activeService %}
    <div class="pricing-tabs__panel">
      {% if service.plans %}
      <h2 class="visually-hidden">{{ service.label }} plans</h2>
      {{ websitePlans | safe }}
      {% else %}
      <div class="card pricing-tabs__placeholder">
        <h2 class="pricing-tabs__placeholder-title">{{ service.name }}</h2>
        <p class="pricing-tabs__placeholder-lead">{{ section.placeholder.lead }}</p>
        <p>{{ section.placeholder.body }}</p>
        <div class="pricing-tabs__placeholder-actions">
          <a class="button button--primary" href="{{ section.placeholder.cta.href }}"{% if section.placeholder.cta.dialogTarget %} data-dialog-target="{{ section.placeholder.cta.dialogTarget }}"{% endif %}>{{ section.placeholder.cta.label }}</a>
          <a class="button button--secondary" href="{{ service.href }}" aria-label="{{ section.placeholder.linkLabel }}: {{ service.name }}">{{ section.placeholder.linkLabel }}</a>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}
    {% endfor %}
    {% else %}
    {{ websitePlans | safe }}
    {% endif %}
  </div>
</section>
