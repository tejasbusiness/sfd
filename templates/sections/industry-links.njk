{# Homepage local-service bento (docs/13 §8.4). Only used by the homepage.
   Tiles are not links: there are no pages for these service niches yet, and
   docs/13 §amendment-6 forbids shipping links that 404. Add `item.href` and
   wrap the tile in a link only once a matching page exists. #}
<section class="section industry-links">
  <div class="container">
    <h2>{{ section.heading }}</h2>
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
    <div class="industry-links__grid">
      {% for item in section.items %}
      <div class="card industry-links__item industry-links__item--{{ item.size }}" data-reveal>
        <span class="industry-links__icon" aria-hidden="true">{{ item.icon | safe }}</span>
        <h3>{{ item.label }}</h3>
        <p>{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
