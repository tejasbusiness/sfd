{# Generic clickable card grid — used by the Industries index (linking to the
   five vertical pages) and the Websites hub (linking to Portfolio/Case
   Studies). Not homepage-only: styled sitewide in components.css. #}
<section class="section {{ 'section--tinted' if section.tinted else '' }} link-cards">
  <div class="container">
    {% if section.eyebrow %}<p class="eyebrow">{{ section.eyebrow }}</p>{% endif %}
    <h2>{{ section.heading }}</h2>
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
    <div class="link-cards__grid">
      {% for item in section.items %}
      <a class="card link-cards__item" href="{{ item.href }}" data-reveal>
        {% if item.icon %}<span class="link-cards__icon" aria-hidden="true">{{ item.icon | safe }}</span>{% endif %}
        <h3>{{ item.label }}</h3>
        <p>{{ item.description }}</p>
        <span class="link-cards__arrow" aria-hidden="true">&rarr;</span>
      </a>
      {% endfor %}
    </div>
    {% if section.closing %}<p class="link-cards__closing">{{ section.closing }}</p>{% endif %}
    {% if section.cta %}
    <p class="link-cards__cta">
      <a class="button button--secondary" href="{{ section.cta.href }}">{{ section.cta.label }}</a>
    </p>
    {% endif %}
  </div>
</section>
