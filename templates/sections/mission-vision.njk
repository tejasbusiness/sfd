{# Mission and Vision side by side (About page). Built on the shared .card; the
   Vision card only changes fill (brand purple) for emphasis. Copy lives in the page JSON. #}
<section class="section mission-vision">
  <div class="container">
    {% if section.eyebrow %}<p class="eyebrow">{{ section.eyebrow }}</p>{% endif %}
    {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
    <div class="mission-vision__grid">
      {% for item in section.items %}
      <article class="card mission-vision__card{{ ' mission-vision__card--dark' if item.tone == 'dark' }}" data-reveal>
        <span class="mission-vision__icon" aria-hidden="true">
          {% if item.icon == "vision" %}
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          {% else %}
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/></svg>
          {% endif %}
        </span>
        <p class="mission-vision__label">{{ item.label }}</p>
        <h3 class="mission-vision__statement">{{ item.statement }}</h3>
        <p class="mission-vision__body">{{ item.body }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
