{# "Preview Concepts" (docs/13 §8.7) — replaces the "featured work" idea from the
   first draft. SFD has no verified client work yet, so every example is permanently,
   visibly labeled as illustrative. This caption is hardcoded here, not JSON-driven,
   so it can never be accidentally omitted by a future content edit. #}
<section class="section preview-concepts">
  <div class="container">
    <h2>{{ section.heading }}</h2>
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
    <div class="preview-concepts__grid">
      {% for concept in section.items %}
      <div class="card preview-concepts__item {{ 'preview-concepts__item--dominant' if loop.first else '' }}" data-reveal>
        <div class="browser-frame browser-frame--sm">
          <div class="browser-frame__bar">
            <span class="browser-frame__dot"></span>
            <span class="browser-frame__dot"></span>
            <span class="browser-frame__dot"></span>
            <span class="browser-frame__address">{{ concept.mockBusinessName | lower | replace(" ", "") }}.com</span>
          </div>
          <div class="browser-frame__body">
            <div class="mock-site__nav">
              <span class="mock-site__logo">{{ concept.mockBusinessName }}</span>
              <span class="mock-site__nav-links">{{ concept.mockNavLinks }}</span>
              <span class="mock-site__cta">{{ concept.mockCta }}</span>
            </div>
            <div class="mock-site__hero">
              <div class="mock-site__hero-text">
                <p class="mock-site__hero-heading">{{ concept.mockHeroHeading }}</p>
                <p class="mock-site__hero-sub">{{ concept.mockHeroSub }}</p>
                <span class="mock-site__hero-button">{{ concept.mockCta }}</span>
              </div>
              <div class="preview-concepts__icon-panel" aria-hidden="true">
                {% if loop.index == 1 %}
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
                  <path d="M3 11l9-8 9 8M5 10v10h14V10" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M9 20v-6h6v6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {% elif loop.index == 2 %}
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
                  <path d="M7 3v7a2 2 0 002 2v9M7 3a2 2 0 00-2 2v5a2 2 0 002 2M11 3v9" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M17 3c-1.5 0-3 2-3 5s1 4 3 4 0 9 0 9" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {% else %}
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M3 9h18M8 3v4M16 3v4" stroke-linecap="round" />
                  <path d="M8 14l2.5 2.5L16 11" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {% endif %}
              </div>
            </div>
            <div class="mock-site__trust">
              <span>✓ {{ concept.mockTrustCue | safe }}</span>
            </div>
          </div>
        </div>
        <p class="preview-concepts__industry">{{ concept.industryLabel }}</p>
        <h3>{{ concept.headline }}</h3>
        <p>{{ concept.description }}</p>
        <p class="preview-concepts__disclaimer">Illustrative website concept — not a published client project.</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
