{# Shared partial for the "free-preview-cta" and "booking-cta" block types (docs/05). #}
<section class="section cta-banner {{ 'section--brand' if section.tone == 'brand' else '' }}">
  <div class="container cta-banner__inner" data-reveal>
    <h2>{{ section.heading }}</h2>
    {% if section.body %}<p>{{ section.body }}</p>{% endif %}
    <div class="cta-banner__actions">
      {% if section.type == "booking-cta" %}
      <a
        class="button button--primary"
        href="{{ section.primaryCta.href }}"
        data-dialog-target="booking-modal"
      >{{ section.primaryCta.label }}</a>
      {% else %}
      <a class="button button--primary" href="{{ section.primaryCta.href }}">{{ section.primaryCta.label }}</a>
      {% endif %}
      {% if section.secondaryCta %}
      <a
        class="button button--secondary {{ 'button--on-brand' if section.tone == 'brand' else '' }}"
        href="{{ section.secondaryCta.href }}"
        {% if section.secondaryCta.dialogTarget %}data-dialog-target="{{ section.secondaryCta.dialogTarget }}"{% endif %}
      >{{ section.secondaryCta.label }}</a>
      {% endif %}
    </div>
  </div>
</section>
