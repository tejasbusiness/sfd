# Secrets for local edge functions (create-booking, manage-booking,
# create-checkout-session, stripe-webhook, razorpay-webhook, detect-currency,
# send-push).
#
# Copy to supabase/functions/.env (gitignored) and fill in real values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# `supabase start` / `supabase functions serve` — do not set them here.
#
# Usage: npx supabase functions serve --env-file supabase/functions/.env

# --- Razorpay (INR) ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Stripe (USD) ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site URL (Stripe checkout success/cancel redirects) ----------------------
SITE_URL=http://localhost:5173

# --- Geolocation (currency default) ---------------------------------------------
# Optional — detect-currency falls back to the free ip-api.com tier if unset.
GEOLOCATION_API_KEY=

# --- Web Push (send-push edge function, admin notification bell) ----------------
# Generate with: node scripts/generate-vapid-keys.mjs (run from repo root).
# VITE_VAPID_PUBLIC_KEY must match the same value in .env.local/.env — the
# public key is embedded in the signed VAPID JWT alongside the private key.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@synergyfirstdigital.com

# --- Automated email sequences (send-email, run-email-sweeps) -------------------
# CRON_SECRET protects run-email-sweeps from being triggered by anyone but the
# scheduled cron job — generate with `openssl rand -hex 32`. The same value
# must be passed as the Authorization: Bearer header by whatever cron job
# calls this function (VPS crontab + curl; see docs/logs.md for the exact
# command once deployed).
CRON_SECRET=
