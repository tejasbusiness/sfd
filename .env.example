# Names only — no real values or secrets belong in this file or in git.
#
# Everything below is consumed by the secure n8n booking workflow / hosting
# environment (docs/07-booking-engine.md), NOT by this static-site build.
# None of these may ever appear in browser code or public JSON (CLAUDE.md rule 11).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SHARED_SECRET=
BOOKING_NOTIFICATION_EMAIL=

# Build-time only, optional (the --mode CLI flag takes precedence over this).
BUILD_MODE=development
