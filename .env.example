# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Local dev: run `npx supabase status` after `npx supabase start` to get the
# local API URL and anon key. Production: use the values from the VPS-hosted
# Supabase instance instead.

# --- Supabase ----------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Service-role key is server-only (edge functions) — never prefix with VITE_,
# never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP (transactional + automated sequence email) --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=SynergyFirst Digital

# --- Razorpay (INR) ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Stripe (USD) ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site URL (used for Stripe checkout success/cancel redirects) -------------
# Server-side env var for edge functions (Deno.env), not a VITE_ var.
SITE_URL=http://localhost:5173

# --- AI provider (chatbot, Rule B) ----------------------------------------------
# Active/fallback provider selection itself lives in the settings table
# (admin-editable); these are just the credentials for whichever is active.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Geolocation (currency default) ---------------------------------------------
# IP geolocation provider key, if the chosen service requires one.
GEOLOCATION_API_KEY=

# --- Web Push (admin notification bell, docs/07) --------------------------------
# Generate a pair with: `node scripts/generate-vapid-keys.mjs`. Public key is
# read client-side (VITE_ prefix, safe to expose) by pushManager.subscribe();
# private key signs push payloads server-side in the send-push edge function
# and must also be set in supabase/functions/.env (never VITE_-prefixed there).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@synergyfirstdigital.com
