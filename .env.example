# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Local dev: run `npx supabase status` after `npx supabase start` to get the
# local API URL and anon key. Production: use the values from the VPS-hosted
# Supabase instance instead.

# --- Supabase ----------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Service-role key is server-only (edge functions) — never prefix with VITE_,
# never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP (transactional + automated sequence email) --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=SynergyFirst Digital

# --- Razorpay (INR) ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Stripe (USD) ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI provider (chatbot, Rule B) ----------------------------------------------
# Active/fallback provider selection itself lives in the settings table
# (admin-editable); these are just the credentials for whichever is active.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Geolocation (currency default) ---------------------------------------------
# IP geolocation provider key, if the chosen service requires one.
GEOLOCATION_API_KEY=
