# Names only: no real values or secrets belong in this file or in git.
#
# Copy to `.env` (production, on the server ABOVE the web root) or `.env-local`
# (your machine, connecting to the live DB through the SSH tunnel) and fill in.
# Read only by the PHP API (api/) and the migration/tunnel scripts, never by
# browser code or public JSON (CLAUDE.md rule 11).

APP_ENV=production            # production | local (local rows are flagged is_test=1)
SITE_URL=https://synergyfirstdigital.com
ALLOWED_ORIGINS=https://synergyfirstdigital.com,https://www.synergyfirstdigital.com
RATE_LIMIT_SALT=              # long random string used to hash IP addresses

# Database (local uses the tunnel: 127.0.0.1 and port 3307)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# SSH tunnel to the VPS (used only by `npm run tunnel`, local file only)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
TUNNEL_LOCAL_PORT=3307

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls               # tls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SynergyFirst Digital
MAIL_OWNER_TO=
MAIL_LOCAL=0                  # 1 = also send real emails from a local environment

# Google Calendar / Meet (bookings are saved without it while GOOGLE_ENABLED=0)
GOOGLE_ENABLED=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Build-time only, optional (the --mode CLI flag takes precedence over this).
BUILD_MODE=development
